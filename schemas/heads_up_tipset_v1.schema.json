{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heads Up tip set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tips"
  ],
  "properties": {
    "tips": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_signature",
          "tip_text"
        ],
        "properties": {
          "input_signature": {
            "type": "string",
            "minLength": 1
          },
          "tip_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
