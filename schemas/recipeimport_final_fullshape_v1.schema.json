{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipeImport Final Draft V1 Full Shape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_v",
    "source",
    "recipe",
    "steps"
  ],
  "properties": {
    "schema_v": {
      "type": "number",
      "const": 1
    },
    "source": {
      "type": ["string", "null"]
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "notes",
        "image_url",
        "confidence",
        "cook_time_seconds",
        "variants",
        "yield_units",
        "yield_phrase",
        "yield_unit_name",
        "yield_detail"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": ["string", "null"]
        },
        "notes": {
          "type": ["string", "null"]
        },
        "image_url": {
          "type": ["string", "null"]
        },
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "cook_time_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "variants": {
          "type": ["array", "null"],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "yield_units": {
          "type": "number",
          "minimum": 1
        },
        "yield_phrase": {
          "type": ["string", "null"]
        },
        "yield_unit_name": {
          "type": ["string", "null"]
        },
        "yield_detail": {
          "type": ["string", "null"]
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instruction",
          "time_seconds",
          "temperature",
          "temperature_unit",
          "ingredient_lines"
        ],
        "properties": {
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "time_seconds": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "temperature": {
            "type": ["number", "null"]
          },
          "temperature_unit": {
            "type": ["string", "null"]
          },
          "ingredient_lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ingredient_id",
                "linked_recipe_id",
                "quantity_kind",
                "input_qty",
                "input_unit_id",
                "note",
                "preparation",
                "raw_text",
                "confidence",
                "raw_unit_text",
                "raw_ingredient_text",
                "is_optional"
              ],
              "properties": {
                "ingredient_id": {
                  "type": ["string", "null"]
                },
                "linked_recipe_id": {
                  "type": ["string", "null"]
                },
                "quantity_kind": {
                  "type": "string",
                  "enum": ["exact", "approximate", "unquantified"]
                },
                "input_qty": {
                  "type": ["number", "null"]
                },
                "input_unit_id": {
                  "type": ["string", "null"]
                },
                "note": {
                  "type": ["string", "null"]
                },
                "preparation": {
                  "type": ["string", "null"]
                },
                "raw_text": {
                  "type": ["string", "null"]
                },
                "confidence": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1
                },
                "raw_unit_text": {
                  "type": ["string", "null"]
                },
                "raw_ingredient_text": {
                  "type": ["string", "null"]
                },
                "is_optional": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
